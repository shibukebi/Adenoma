{
  "schema_version": "reviewer_registry_v1",
  "registry_version": "1.0.0",
  "task_request_schema_version": "reviewer_task_request_v1",
  "observation_schema_version": "reviewer_observation_v1",
  "ledger_record_schema_version": "reviewer_ledger_record_v1",
  "logical_reviewers_may_share_backend": true,
  "retry_policy": {
    "transport_or_model_retries": 1,
    "schema_repair_attempts": 1,
    "max_conflict_resolution_rounds": 2,
    "retry_same_roi_when_not_evaluable": false
  },
  "scale_semantics": [
    {
      "magnification": 2.5,
      "purpose": "roi_overview_evidence",
      "prohibited_inferences": [
        "whole_slide_quantitation",
        "whole_slide_cluster_or_heterogeneity_inference",
        "cytologic_grading"
      ]
    },
    {
      "magnification": 5,
      "purpose": "overall_architecture_component_extent_and_mixing",
      "prohibited_inferences": [
        "whole_slide_quantitation",
        "fine_cytologic_grading"
      ]
    },
    {
      "magnification": 10,
      "purpose": "crypt_level_architecture",
      "prohibited_inferences": [
        "whole_slide_quantitation",
        "definitive_high_grade_call_without_20x"
      ]
    },
    {
      "magnification": 20,
      "purpose": "cytology_and_high_grade_or_definite_dysplasia",
      "prohibited_inferences": [
        "whole_slide_quantitation",
        "whole_roi_architecture_extent_from_single_field"
      ]
    }
  ],
